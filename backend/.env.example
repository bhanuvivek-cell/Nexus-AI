# =============================================================================
#  Nexus AI - Backend Environment Configuration (.env)
# =============================================================================

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET=super_secret_local_dev_jwt_key_nexus_ai_2025
JWT_ALGORITHM=HS256
JWT_EXPIRES_DAYS=30

# -----------------------------------------------------------------------------
# Google Gemini AI Configuration & API Key Rotation
# -----------------------------------------------------------------------------
# Active Model: gemini-3.1-flash-lite (default) or gemini-2.5-flash / gemini-1.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Option 1: Single Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: API Key Rotation (comma, semicolon, or newline separated)
# When multiple keys are provided, Nexus AI distributes requests round-robin
# and automatically fails over if a key encounters rate limits (429) or quota errors.
GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...

# -----------------------------------------------------------------------------
# Supabase Configuration (Optional for local development)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=
